# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/easy-programming

# Client URLs used for CORS and PayPal redirects
CLIENT_URL=http://localhost:5173
CLIENT_PROD_URL=https://your-domain.com

# Auth. Use a long random string in production.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Cloudinary (course images and lecture videos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# PayPal (sandbox or live)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET_KEY=
